# Base URL of the deployed prediction API (see /api and api/README.md).
# Leave unset during local development with no service running — every
# screen that calls it (AssessScreen) falls back to the local heuristic
# automatically when this is empty or the service is unreachable.
#
# Example once deployed to Cloud Run:
# EXPO_PUBLIC_PREDICTION_API_URL=https://healthcheck-api-xxxxx-ew.a.run.app
EXPO_PUBLIC_PREDICTION_API_URL=

# Shared secret sent as the X-API-Key header on every predict call. Must
# match the PREDICTION_API_KEY env var set on the Cloud Run service (see
# api/README.md). Leave both unset in local dev to skip the check entirely.
EXPO_PUBLIC_PREDICTION_API_KEY=
