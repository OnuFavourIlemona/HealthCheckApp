{
  "expo": {
    "name": "HealthCheck",
    "slug": "HealthCheckApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.onufavour.healthcheck",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-navigation-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HealthCheck uses your location to find hospitals and pharmacies near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HealthCheck needs access to your photos so you can set a profile picture."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0E8F2F"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "HealthCheck needs your microphone to record voice notes for ProConnect."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5458b9a2-c318-41b4-a609-3278a171f64e"
      }
    },
    "owner": "favouronu"
  }
}
